+struct CaptureStatistics {
+    enabled: bool,
+    started: Instant,
+    fresh: u64,
+    reused: u64,
+}
+
+impl CaptureStatistics {
+    fn new() -> Self {
+        Self {
+            enabled: std::env::var_os("WEYLUS_CAPTURE_STATS").is_some(),
+            started: Instant::now(),
+            fresh: 0,
+            reused: 0,
+        }
+    }
+
+    fn record(&mut self, fresh: bool) {
+        if !self.enabled {
+            return;
+        }
+        if fresh { self.fresh += 1; } else { self.reused += 1; }
+        let elapsed = self.started.elapsed().as_secs_f64();
+        if elapsed >= 3.0 {
+            debug!(
+                "PipeWire capture: fresh_fps={:.1} reused_fps={:.1} capture_fps={:.1}",
+                self.fresh as f64 / elapsed,
+                self.reused as f64 / elapsed,
+                (self.fresh + self.reused) as f64 / elapsed,
+            );
+            self.started = Instant::now();
+            self.fresh = 0;
+            self.reused = 0;
+        }
+    }
+}
