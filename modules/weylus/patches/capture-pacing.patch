+    #[test]
+    fn capture_does_not_wait_for_future_gstreamer_timestamps() {
+        gst::init().unwrap();
+        let pipeline = gst::Pipeline::new();
+        let src = gst::ElementFactory::make("appsrc").build().unwrap()
+            .dynamic_cast::<gstreamer_app::AppSrc>().unwrap();
+        src.set_is_live(true);
+        src.set_format(gst::Format::Time);
+        src.set_caps(Some(&"video/x-raw,format=BGRx,width=1,height=1,framerate=120/1"
+            .parse::<gst::Caps>().unwrap()));
+        let sink = PipeWireRecorder::make_appsink().unwrap();
+        assert!(!sink.property::<bool>("sync"));
+        assert!(!sink.property::<bool>("enable-last-sample"));
+        let src_element = src.clone().upcast::<gst::Element>();
+        let sink_element = sink.clone().upcast::<gst::Element>();
+        pipeline.add_many([&src_element, &sink_element]).unwrap();
+        src_element.link(&sink_element).unwrap();
+        let mut recorder = PipeWireRecorder::finish(pipeline, sink);
+        recorder.pipeline.set_state(gst::State::Playing).unwrap();
+        let mut buffer = gst::Buffer::with_size(4).unwrap();
+        // This frame must be available now, not five seconds from now.
+        buffer.get_mut().unwrap().set_pts(gst::ClockTime::from_seconds(5));
+        src.push_buffer(buffer).unwrap();
+        let deadline = Instant::now() + Duration::from_millis(500);
+        loop {
+            if recorder.next_sample().is_some() { break; }
+            assert!(Instant::now() < deadline, "appsink delayed a capture frame");
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
