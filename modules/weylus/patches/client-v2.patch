+function catch_up_video(
+    video: HTMLVideoElement,
+    low_latency: boolean,
+    state: { last_seek: number },
+) {
+    if (video.error || video.seeking || video.readyState < 2 || !video.buffered.length)
+        return;
+    const now = performance.now();
+    if (now - state.last_seek < 750)
+        return;
+    // Use successfully appended media, not seekable (which may advertise a
+    // much larger live timeline), and keep some data ahead of the decoder.
+    const last_range = video.buffered.length - 1;
+    const end = video.buffered.end(last_range);
+    const start = video.buffered.start(last_range);
+    const lag = end - video.currentTime;
+    if (!isFinite(start) || !isFinite(end) || !isFinite(video.currentTime)
+        || lag <= (low_latency ? 0.35 : 3))
+        return;
+    const target = Math.max(start, end - (low_latency ? 0.12 : 0.25));
+    if (target > video.currentTime) {
+        video.currentTime = target;
+        state.last_seek = now;
+    }
+}
