+#[cfg(test)]
+mod connection_tests {
+    use super::*;
+    use std::io;
+    use std::pin::Pin;
+    use std::task::{Context, Poll};
+
+    struct BrokenWriter;
+
+    impl tokio::io::AsyncRead for BrokenWriter {
+        fn poll_read(
+            self: Pin<&mut Self>, _: &mut Context<'_>, _: &mut tokio::io::ReadBuf<'_>,
+        ) -> Poll<io::Result<()>> {
+            Poll::Pending
+        }
+    }
+
+    impl tokio::io::AsyncWrite for BrokenWriter {
+        fn poll_write(
+            self: Pin<&mut Self>, _: &mut Context<'_>, _: &[u8],
+        ) -> Poll<io::Result<usize>> {
+            Poll::Ready(Err(io::Error::new(io::ErrorKind::BrokenPipe, "tablet disconnected")))
+        }
+
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+
+        fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    #[tokio::test]
+    async fn broken_pipe_closes_both_channels_even_when_the_reader_is_still_waiting() {
+        let websocket = WebSocket::after_handshake(BrokenWriter, fastwebsockets::Role::Server);
+        let (sender, mut receiver) = weylus_websocket_channel(
+            websocket, Arc::new(tokio::sync::Semaphore::new(0)),
+        );
+        assert!(sender.sender.send(WsMessage::Video(vec![0; 64])).await.is_ok());
+        assert!(tokio::time::timeout(Duration::from_secs(1), receiver.recv.recv())
+            .await.expect("broken-pipe reader was not closed").is_none());
+        assert!(sender.sender.send(WsMessage::Video(vec![0])).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn stalled_writer_closes_both_channels_instead_of_leaking_a_capture_thread() {
+        let (server, _silent_peer) = tokio::io::duplex(16);
+        let websocket = WebSocket::after_handshake(server, fastwebsockets::Role::Server);
+        let (sender, mut receiver) = weylus_websocket_channel(
+            websocket, Arc::new(tokio::sync::Semaphore::new(0)),
+        );
+        assert!(sender.sender.send(WsMessage::Video(vec![0; 1024])).await.is_ok());
+        // The reader has no reason to finish: only writer timeout/cleanup can close it.
+        assert!(tokio::time::timeout(Duration::from_secs(5), receiver.recv.recv())
+            .await.expect("stalled connection was not closed").is_none());
+        assert!(sender.sender.send(WsMessage::Video(vec![0])).await.is_err());
+    }
+}
