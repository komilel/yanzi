+#[cfg(test)]
+mod timing_tests {
+    use super::*;
+    use std::sync::{Arc, Mutex};
+
+    #[test]
+    fn mp4_timing_is_monotonic_and_advertises_the_requested_rate() {
+        for fps in [60, 120] {
+            let bytes = Arc::new(Mutex::new(Vec::new()));
+            let sink = bytes.clone();
+            let options = EncoderOptions {
+                try_vaapi: false,
+                try_nvenc: false,
+                try_videotoolbox: false,
+                try_mediafoundation: false,
+                input_is_dmabuf: false,
+            };
+            let encoder = VideoEncoder::with_frame_rate(
+                320, 200, 320, 200, fps as f64,
+                move |data| sink.lock().unwrap().extend_from_slice(data),
+                options,
+            ).unwrap();
+            let pixels = vec![64u8; 320 * 200 * 4];
+            for index in 0..30 {
+                // Deliberately repeat a clock reading, as can happen during a burst.
+                let micros = if index == 12 { 11 * 1_000_000 / fps } else { index * 1_000_000 / fps };
+                let mut err = CError::new();
+                unsafe {
+                    fill_bgr0(encoder.handle, pixels.as_ptr(), 320 * 4, &mut err);
+                }
+                assert!(!err.is_err(), "{err}");
+                unsafe { encode_video_frame(encoder.handle, micros, &mut err); }
+                assert!(!err.is_err(), "{err}");
+            }
+            drop(encoder);
+            let path = std::env::temp_dir().join(format!("weylus-timing-{}-{fps}.mp4", std::process::id()));
+            std::fs::write(&path, &*bytes.lock().unwrap()).unwrap();
+            let probe = std::process::Command::new("ffprobe").args([
+                "-v", "error", "-select_streams", "v:0", "-show_packets", "-show_streams",
+                "-show_entries", "stream=r_frame_rate,avg_frame_rate:packet=dts_time,pts_time,duration_time",
+                "-of", "json",
+            ]).arg(&path).output().unwrap();
+            assert!(probe.status.success(), "{}", String::from_utf8_lossy(&probe.stderr));
+            let probe: serde_json::Value = serde_json::from_slice(&probe.stdout).unwrap();
+            let rate = format!("{fps}/1");
+            assert_eq!(probe["streams"][0]["r_frame_rate"], rate);
+            assert_eq!(probe["streams"][0]["avg_frame_rate"], rate);
+            let packets = probe["packets"].as_array().unwrap();
+            assert_eq!(packets.len(), 30);
+            for packet in packets {
+                assert_eq!(packet["pts_time"], packet["dts_time"]);
+                let duration: f64 = packet["duration_time"].as_str().unwrap().parse().unwrap();
+                assert!((duration - 1.0 / fps as f64).abs() < 0.000002, "{packet}");
+            }
+            let timestamps: Vec<f64> = packets.iter()
+                .map(|packet| packet["dts_time"].as_str().unwrap().parse().unwrap()).collect();
+            assert!(timestamps.windows(2).all(|pair| pair[0] < pair[1]), "{timestamps:?}");
+
+            // Inspect H.264 VUI directly: container FPS guesses can hide bad SPS timing.
+            let headers = std::process::Command::new("ffmpeg").args([
+                "-hide_banner", "-loglevel", "trace", "-i",
+            ]).arg(&path).args([
+                "-map", "0:v:0", "-c:v", "copy", "-bsf:v", "trace_headers",
+                "-frames:v", "1", "-f", "null", "-",
+            ]).output().unwrap();
+            assert!(headers.status.success(), "{}", String::from_utf8_lossy(&headers.stderr));
+            let trace = String::from_utf8_lossy(&headers.stderr);
+            let value = |name: &str| -> f64 {
+                trace.lines().find(|line| line.contains(name))
+                    .unwrap_or_else(|| panic!("Missing {name}: {trace}"))
+                    .rsplit('=').next().unwrap().trim().parse().unwrap()
+            };
+            assert_eq!(value("time_scale") / (2.0 * value("num_units_in_tick")), fps as f64);
+            std::fs::remove_file(path).unwrap();
+        }
+    }
+}
