+// PipeWire node IDs change when the portal creates a new sharing session.
+// Match an exact name first; only fall back by kind when there is one candidate.
+function find_capturable_index(current: string | undefined, names: string[]): number {
+    if (!current)
+        return names.length ? 0 : -1;
+    const exact = names.indexOf(current);
+    if (exact >= 0)
+        return exact;
+    if (current.startsWith("Pipewire ") && current.includes(", path: ")) {
+        const kind = current.split(", path: ")[0];
+        const matches = names.map((name, index) => ({ name, index }))
+            .filter(item => item.name.split(", path: ")[0] === kind);
+        if (matches.length === 1)
+            return matches[0].index;
+    }
+    return -1;
+}
